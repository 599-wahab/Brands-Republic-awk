# Server-side only. Never prefix this key with NEXT_PUBLIC_ or VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Temporary server-side CRM login. Use a unique password and 32+ character session secret.
CRM_LOGIN_ID=admin
CRM_LOGIN_PASSWORD=replace-with-a-strong-password
CRM_SESSION_SECRET=replace-with-at-least-32-random-characters
CRM_LOGIN_NAME=Brands Republic Admin
CRM_LOGIN_EMAIL=operations@brandsrepublic.co.uk
